from typing import Tuple

class StreamingRestorer:
    def push_chunk(self, chunk: str) -> str: ...
    def finish(self) -> str: ...

class Vault:
    def __init__(self) -> None: ...
    def restore(self, text: str) -> str: ...
    def streaming_restorer(self) -> StreamingRestorer: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(json_str: str) -> "Vault": ...
    def to_encrypted_json(self, passphrase: str) -> str: ...
    @staticmethod
    def from_encrypted_json(encrypted_json: str, passphrase: str) -> "Vault": ...
    def __len__(self) -> int: ...

class Veil:
    def __init__(self, mode: str = "placeholder", secret_key: str = "pii-veil-default-seed-key") -> None: ...
    @staticmethod
    def from_policy_json(policy_json: str) -> "Veil": ...
    def add_custom_rule(self, name: str, pattern: str) -> None: ...
    def add_allowlist(self, entry: str) -> None: ...
    def add_sensitive_json_key(self, key: str) -> None: ...
    def redact(self, text: str) -> Tuple[str, Vault]: ...
    def redact_with_vault(self, text: str, vault: Vault) -> str: ...
    def redact_json(self, json_str: str) -> Tuple[str, Vault]: ...
    def scan_json(self, text: str) -> str: ...
