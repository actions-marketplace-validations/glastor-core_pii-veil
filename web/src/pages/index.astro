---
import Hero from '../components/Hero.astro';
import Playground from '../components/Playground.astro';
import Benchmarks from '../components/Benchmarks.astro';
import Enterprise from '../components/Enterprise.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-cyber-dark text-slate-100 antialiased selection:bg-cyber-neon selection:text-cyber-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=1" />
    <link rel="shortcut icon" href="/favicon.ico?v=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=1" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=1" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>pii-veil — Ultrafast In-Browser & Backend PII Anonymizer</title>
    <meta name="description" content="Sub-millisecond reversible PII and secrets anonymization engine for LLMs and AI agents. Compiles to WebAssembly, Rust, Python, Node.js, and CLI." />
    <!-- Open Graph -->
    <meta property="og:title" content="pii-veil — Sub-Millisecond LLM Privacy Engine" />
    <meta property="og:description" content="Sanitize credit cards, emails, and secrets locally in 100 µs with zero cloud egress." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pii-veil.glastor.es" />
  </head>
  <body class="min-h-screen flex flex-col justify-between overflow-x-hidden">
    <!-- Navbar -->
    <nav class="sticky top-0 z-50 bg-cyber-dark/80 backdrop-blur-md border-b border-cyber-border/70">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          <img src="/favicon.svg" alt="pii-veil logo" class="w-8 h-8 rounded-lg shadow-sm border border-cyber-border/80 group-hover:border-cyber-neon/80 transition" />
          <span class="font-black text-xl tracking-tight text-white group-hover:text-cyber-neon transition">
            pii<span class="text-cyber-neon">-veil</span>
          </span>
          <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-slate-800 text-cyber-muted border border-slate-700">
            v0.1.3
          </span>
        </a>

        <!-- Links -->
        <div class="hidden md:flex items-center gap-6 text-sm font-medium text-cyber-muted">
          <a href="#demo" class="hover:text-cyber-neon transition">Live Demo</a>
          <a href="#benchmarks" class="hover:text-cyber-cyan transition">Benchmarks</a>
          <a href="#enterprise" class="hover:text-cyber-purple transition">Enterprise</a>
          <a href="https://github.com/glastor-core/pii-veil" target="_blank" class="hover:text-white transition flex items-center gap-1">
            GitHub
          </a>
        </div>

        <!-- Action Button -->
        <div class="flex items-center gap-3">
          <a
            href="mailto:founder@glastor.es"
            class="px-4 py-2 text-xs font-mono font-bold rounded-lg bg-cyber-neon hover:bg-cyber-neonHover text-cyber-dark transition shadow-[0_0_15px_rgba(0,255,157,0.3)]"
          >
            Get Enterprise SLA
          </a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow">
      <Hero />
      <Playground />
      <Benchmarks />
      <Enterprise />
    </main>

    <!-- Footer -->
    <footer class="border-t border-cyber-border bg-black/60 py-10 px-4 text-center text-xs font-mono text-cyber-muted">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p>© 2026 <strong class="text-white">GLASTOR® Core</strong>. Open Source under Apache-2.0 & MIT License.</p>
        </div>
        <div class="flex items-center gap-6">
          <a href="https://github.com/glastor-core/pii-veil" target="_blank" class="hover:text-white transition">GitHub Repo</a>
          <a href="https://crates.io/crates/pii-veil-core" target="_blank" class="hover:text-white transition">crates.io</a>
          <a href="https://pypi.org/project/glastor-pii-veil/" target="_blank" class="hover:text-white transition">PyPI</a>
          <a href="https://www.npmjs.com/package/pii-veil-node" target="_blank" class="hover:text-white transition">npm</a>
          <a href="mailto:founder@glastor.es" class="text-cyber-neon hover:underline">founder@glastor.es</a>
        </div>
      </div>
    </footer>

    <!-- Client-side Playground Bootstrapper -->
    <script>
      import { initPlayground } from '../scripts/playground.ts';
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPlayground);
      } else {
        initPlayground();
      }
    </script>
  </body>
</html>
