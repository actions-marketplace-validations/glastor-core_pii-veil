---
import Hero from '../components/Hero.astro';
import ArchitectureFlow from '../components/ArchitectureFlow.astro';
import Playground from '../components/Playground.astro';
import DetectorsBento from '../components/DetectorsBento.astro';
import CodeTabs from '../components/CodeTabs.astro';
import Benchmarks from '../components/Benchmarks.astro';
import Enterprise from '../components/Enterprise.astro';
import Faq from '../components/Faq.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-cyber-dark text-slate-100 antialiased selection:bg-cyber-neon selection:text-cyber-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=1" />
    <link rel="shortcut icon" href="/favicon.ico?v=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=1" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=1" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>GLASTOR® — pii-veil v0.1.4 | Ultrafast In-Browser & Backend PII Anonymizer</title>
    <meta name="description" content="Sub-millisecond reversible PII and secrets anonymization engine for LLMs and AI agents. Compiles to WebAssembly, Rust, Python, Node.js, and CLI." />
    <!-- Open Graph -->
    <meta property="og:title" content="GLASTOR® — pii-veil v0.1.4 | Sub-Millisecond LLM Privacy Engine" />
    <meta property="og:description" content="Sanitize credit cards, emails, and secrets locally in 100 µs with zero cloud egress." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pii-veil.pages.dev" />
  </head>
  <body class="min-h-screen flex flex-col justify-between overflow-x-hidden">
    <!-- Navbar -->
    <nav class="sticky top-0 z-50 bg-cyber-dark/90 backdrop-blur-md border-b border-cyber-border/70">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 sm:gap-2.5 group shrink-0">
          <img src="/favicon.svg" alt="GLASTOR pii-veil logo" class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg shadow-sm border border-cyber-border/80 group-hover:border-cyber-neon/80 transition" />
          <span class="font-black text-sm sm:text-lg lg:text-xl tracking-tight text-white flex items-center gap-1 sm:gap-1.5 whitespace-nowrap">
            <span class="tracking-wider text-slate-100">GLASTOR®</span>
            <span class="text-cyber-muted font-normal">-</span>
            <span class="group-hover:text-cyber-neon transition">pii<span class="text-cyber-neon">-veil</span></span>
          </span>
          <span class="px-1.5 sm:px-2 py-0.5 text-[10px] font-mono rounded bg-slate-800 text-cyber-neon border border-cyber-border font-semibold shrink-0">
            v0.1.4
          </span>
        </a>

        <!-- Links (Visible on xl: >= 1280px or lg: >= 1024px with compact gap) -->
        <div class="hidden lg:flex items-center gap-4 xl:gap-6 text-xs xl:text-sm font-medium text-cyber-muted shrink-0">
          <a href="#architecture" class="hover:text-cyber-cyan transition whitespace-nowrap">Flujo LLM</a>
          <a href="#demo" class="hover:text-cyber-neon transition whitespace-nowrap">Demo WASM</a>
          <a href="#detectors" class="hover:text-amber-400 transition whitespace-nowrap">18 Detectores</a>
          <a href="#sdks" class="hover:text-cyber-purple transition whitespace-nowrap">SDKs</a>
          <a href="#benchmarks" class="hover:text-cyber-cyan transition whitespace-nowrap">Benchmarks</a>
          <a href="#faq" class="hover:text-white transition whitespace-nowrap">FAQ</a>
          <a href="https://github.com/glastor-core/pii-veil" target="_blank" class="hover:text-white transition flex items-center gap-1 whitespace-nowrap">
            GitHub
          </a>
        </div>

        <!-- Action Button (Always single line, shrink-proof) -->
        <div class="flex items-center gap-3 shrink-0">
          <a
            href="#enterprise"
            class="px-3.5 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-mono font-bold rounded-xl bg-cyber-neon hover:bg-cyber-neonHover text-cyber-dark transition shadow-[0_0_15px_rgba(0,255,157,0.3)] whitespace-nowrap"
          >
            Get Enterprise SLA
          </a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow">
      <Hero />
      <ArchitectureFlow />
      <Playground />
      <DetectorsBento />
      <CodeTabs />
      <Benchmarks />
      <Enterprise />
      <Faq />
    </main>

    <!-- Footer -->
    <footer class="border-t border-cyber-border/80 bg-black/70 py-10 px-4 sm:px-6 lg:px-8 text-xs font-mono text-cyber-muted">
      <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-6 text-center lg:text-left">
        <!-- Brand & License Info -->
        <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-3 text-slate-300">
          <div class="flex items-center gap-2">
            <img src="/favicon.svg" alt="GLASTOR" class="w-5 h-5 rounded" />
            <span>© 2026 <strong class="text-white font-bold tracking-tight">GLASTOR® Core</strong></span>
          </div>
          <span class="hidden sm:inline text-cyber-border">•</span>
          <span class="text-slate-400">Open Source under Apache-2.0 & MIT</span>
        </div>

        <!-- Ecosystem Links (Responsive with flex-wrap and whitespace-nowrap) -->
        <div class="flex flex-wrap items-center justify-center lg:justify-end gap-x-5 gap-y-2.5">
          <a href="https://github.com/glastor-core/pii-veil" target="_blank" class="hover:text-white transition whitespace-nowrap flex items-center gap-1.5">
            <span>🐙</span> GitHub Repo
          </a>
          <a href="https://crates.io/crates/pii-veil-core" target="_blank" class="hover:text-orange-400 transition whitespace-nowrap flex items-center gap-1.5">
            <span>🦀</span> crates.io
          </a>
          <a href="https://pypi.org/project/glastor-pii-veil/" target="_blank" class="hover:text-cyber-cyan transition whitespace-nowrap flex items-center gap-1.5">
            <span>🐍</span> PyPI
          </a>
          <a href="https://www.npmjs.com/package/pii-veil-node" target="_blank" class="hover:text-red-400 transition whitespace-nowrap flex items-center gap-1.5">
            <span>📦</span> npm
          </a>
          <a href="mailto:founder@glastor.es" class="px-2.5 py-1 rounded-lg bg-cyber-neon/10 border border-cyber-neon/30 text-cyber-neon hover:bg-cyber-neon/20 hover:border-cyber-neon transition whitespace-nowrap font-medium flex items-center gap-1.5">
            <span>✉️</span> founder@glastor.es
          </a>
        </div>
      </div>
    </footer>

    <!-- Client-side Playground Bootstrapper -->
    <script>
      import { initPlayground } from '../scripts/playground.ts';
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPlayground);
      } else {
        initPlayground();
      }
    </script>
  </body>
</html>
