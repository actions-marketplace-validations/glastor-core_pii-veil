---
import Hero from '../components/Hero.astro';
import ArchitectureFlow from '../components/ArchitectureFlow.astro';
import Playground from '../components/Playground.astro';
import DetectorsBento from '../components/DetectorsBento.astro';
import CodeTabs from '../components/CodeTabs.astro';
import Benchmarks from '../components/Benchmarks.astro';
import Enterprise from '../components/Enterprise.astro';
import Faq from '../components/Faq.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-cyber-dark text-slate-100 antialiased selection:bg-cyber-neon selection:text-cyber-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=1" />
    <link rel="shortcut icon" href="/favicon.ico?v=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=1" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=1" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Red Hat Typography Family & Material Symbols Outlined -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@700;800;900&family=Red+Hat+Mono:wght@400;500;600;700&family=Red+Hat+Text:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..24,400,0,0&display=swap"
      rel="stylesheet"
    />

    <title>GLASTOR® — pii-veil v1.0.0 GA | Ultrafast In-Browser & Backend PII Anonymizer</title>
    <meta name="description" content="Sub-millisecond reversible PII and secrets anonymization engine for LLMs and AI agents. 19 detectors, 12 global national IDs, SARIF 2.1.0, Prometheus /metrics, and Layered NER." />
    <link rel="canonical" href="https://pii-veil.glastor.es/" />
    <!-- Open Graph -->
    <meta property="og:title" content="GLASTOR® — pii-veil v1.0.0 GA | Sub-Millisecond LLM Privacy Engine" />
    <meta property="og:description" content="Sanitize credit cards, emails, 12 global national IDs, and secrets locally in 100 µs with 100% verified precision and zero cloud egress." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pii-veil.glastor.es" />

    <style is:global>
      h1, h2, h3 {
        font-family: "Red Hat Display", "Red Hat Text", ui-sans-serif, system-ui, sans-serif;
      }
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
        font-size: 1.125rem;
        line-height: 1;
        vertical-align: middle;
        user-select: none;
      }
      a:focus-visible,
      button:focus-visible,
      summary:focus-visible,
      textarea:focus-visible {
        outline: 2px solid #00ff9d;
        outline-offset: 2px;
        border-radius: 0.5rem;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col justify-between overflow-x-hidden font-sans">
    <!-- Navbar -->
    <nav class="sticky top-0 z-50 bg-cyber-dark/90 backdrop-blur-md border-b border-cyber-border/70">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
        <!-- Logo -->
        <a href="/" translate="no" class="notranslate flex items-center gap-2 sm:gap-2.5 group shrink-0">
          <img src="/favicon.svg" alt="GLASTOR pii-veil logo" class="w-8 h-8 sm:w-9 sm:h-9 object-contain group-hover:scale-105 transition-transform duration-200" />
          <span class="font-display font-black text-sm sm:text-lg lg:text-xl tracking-tight text-white flex items-center gap-1 sm:gap-1.5 whitespace-nowrap">
            <span class="tracking-wider text-slate-100">GLASTOR®</span>
            <span class="text-cyber-muted font-normal">-</span>
            <span class="group-hover:text-cyber-neon transition">pii<span class="text-cyber-neon">-veil</span></span>
          </span>
          <span class="px-1.5 sm:px-2 py-0.5 text-[10px] font-mono rounded bg-slate-800 text-cyber-neon border border-cyber-border font-semibold shrink-0">
            v1.0.0
          </span>
        </a>

        <!-- Desktop Links (xl+ to prevent overflow when browser-translated to longer languages) -->
        <div class="hidden xl:flex items-center gap-4 2xl:gap-6 text-xs 2xl:text-sm font-medium text-cyber-muted min-w-0">
          <a href="#demo" class="hover:text-cyber-neon transition">Live Demo</a>
          <a href="#architecture" class="hover:text-cyber-cyan transition">LLM Flow</a>
          <a href="#detectors" class="hover:text-amber-400 transition">19 Detectors</a>
          <a href="#sdks" class="hover:text-cyber-purple transition">SDKs</a>
          <a href="#benchmarks" class="hover:text-cyber-cyan transition">Benchmarks</a>
          <a href="#faq" class="hover:text-white transition">FAQ</a>
          <a href="https://github.com/glastor-core/pii-veil" target="_blank" rel="noopener noreferrer" translate="no" class="notranslate hover:text-white transition flex items-center gap-1.5 shrink-0">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            GitHub
          </a>
        </div>

        <!-- Action Button & Mobile Toggle -->
        <div class="flex items-center gap-2.5 shrink-0">
          <a
            href="#enterprise"
            class="px-3.5 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-mono font-bold rounded-xl bg-cyber-neon hover:bg-cyber-neonHover text-cyber-dark transition shadow-[0_0_15px_rgba(0,255,157,0.3)] whitespace-nowrap"
          >
            Get Enterprise SLA
          </a>
          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            class="xl:hidden inline-flex items-center justify-center w-10 h-10 rounded-xl bg-slate-900 border border-cyber-border text-slate-300 hover:text-white hover:border-cyber-neon/60 transition"
          >
            <span id="mobile-menu-icon" translate="no" aria-hidden="true" class="material-symbols-outlined notranslate">menu</span>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div id="mobile-menu" class="hidden xl:hidden border-t border-cyber-border/70 bg-cyber-dark/95 backdrop-blur-xl px-4 py-4">
        <div class="flex flex-col gap-2 text-sm font-medium text-slate-300">
          <a href="#architecture" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-800/70 hover:text-cyber-cyan transition">LLM Flow</a>
          <a href="#demo" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-800/70 hover:text-cyber-neon transition">Live Demo (WASM)</a>
          <a href="#detectors" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-800/70 hover:text-amber-400 transition">19 Detectors</a>
          <a href="#sdks" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-800/70 hover:text-cyber-purple transition">SDKs & Bindings</a>
          <a href="#benchmarks" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-800/70 hover:text-cyber-cyan transition">Benchmarks</a>
          <a href="#faq" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-800/70 hover:text-white transition">Technical FAQ</a>
          <a href="https://github.com/glastor-core/pii-veil" target="_blank" rel="noopener noreferrer" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-800/70 hover:text-white transition">GitHub Repository</a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow">
      <Hero />

      <!-- Verifiable 4-KPI Strip -->
      <section aria-label="Key verified metrics" class="px-4 max-w-6xl mx-auto pb-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          <div class="bg-cyber-card/80 border border-cyber-border rounded-2xl p-4 text-center">
            <div translate="no" class="notranslate font-mono text-2xl sm:text-3xl font-extrabold text-cyber-neon">~100 µs</div>
            <div class="text-xs text-cyber-muted mt-1">p99 Redaction Latency</div>
          </div>
          <div class="bg-cyber-card/80 border border-cyber-border rounded-2xl p-4 text-center">
            <div translate="no" class="notranslate font-mono text-2xl sm:text-3xl font-extrabold text-white">100.00%</div>
            <div class="text-xs text-cyber-muted mt-1">Verified Precision (0 FP)</div>
          </div>
          <div class="bg-cyber-card/80 border border-cyber-border rounded-2xl p-4 text-center">
            <div translate="no" class="notranslate font-mono text-2xl sm:text-3xl font-extrabold text-cyber-cyan">19 + 12</div>
            <div class="text-xs text-cyber-muted mt-1">Detectors &amp; Global IDs</div>
          </div>
          <div class="bg-cyber-card/80 border border-cyber-border rounded-2xl p-4 text-center">
            <div translate="no" class="notranslate font-mono text-2xl sm:text-3xl font-extrabold text-slate-100">&lt; 15 MB</div>
            <div class="text-xs text-cyber-muted mt-1">Distroless RAM Footprint</div>
          </div>
        </div>
      </section>

      <Playground />
      <ArchitectureFlow />
      <DetectorsBento />
      <CodeTabs />
      <Benchmarks />
      <Enterprise />
      <Faq />
    </main>

    <!-- Footer -->
    <footer class="border-t border-cyber-border/80 bg-black/70 py-10 px-4 sm:px-6 lg:px-8 text-xs font-mono text-cyber-muted">
      <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-6 text-center lg:text-left">
        <!-- Brand & License Info -->
        <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-3 text-slate-300">
          <div class="flex items-center gap-2">
            <img src="/favicon.svg" alt="GLASTOR" class="w-5 h-5 object-contain" />
            <span>© 2026 <strong class="text-white font-bold tracking-tight">GLASTOR® Core</strong></span>
          </div>
          <span class="hidden sm:inline text-cyber-border">•</span>
          <span class="text-slate-400">Open Source under Apache-2.0 & MIT</span>
        </div>

        <!-- Ecosystem Links -->
        <div translate="no" class="notranslate flex flex-wrap items-center justify-center lg:justify-end gap-x-5 gap-y-2.5">
          <a href="https://github.com/glastor-core/pii-veil" target="_blank" rel="noopener noreferrer" class="hover:text-white transition whitespace-nowrap flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            GitHub
          </a>
          <a href="https://crates.io/crates/pii-veil-core" target="_blank" rel="noopener noreferrer" class="hover:text-orange-400 transition whitespace-nowrap flex items-center gap-1.5">
            <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base">deployed_code</span> crates.io
          </a>
          <a href="https://pypi.org/project/glastor-pii-veil/" target="_blank" rel="noopener noreferrer" class="hover:text-cyber-cyan transition whitespace-nowrap flex items-center gap-1.5">
            <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base">terminal</span> PyPI
          </a>
          <a href="https://www.npmjs.com/package/pii-veil-node" target="_blank" rel="noopener noreferrer" class="hover:text-red-400 transition whitespace-nowrap flex items-center gap-1.5">
            <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base">package_2</span> npm
          </a>
          <a href="mailto:founder@glastor.es" class="px-2.5 py-1 rounded-lg bg-cyber-neon/10 border border-cyber-neon/30 text-cyber-neon hover:bg-cyber-neon/20 hover:border-cyber-neon transition whitespace-nowrap font-medium flex items-center gap-1.5">
            <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base">mail</span> founder@glastor.es
          </a>
        </div>
      </div>
    </footer>

    <!-- Client-side Playground & Mobile Menu Bootstrapper -->
    <script>
      import { initPlayground } from '../scripts/playground.ts';
      function bootstrap() {
        initPlayground();
        const menuBtn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const icon = document.getElementById('mobile-menu-icon');
        if (menuBtn && menu && icon) {
          menuBtn.addEventListener('click', () => {
            const isOpen = !menu.classList.contains('hidden');
            menu.classList.toggle('hidden');
            menuBtn.setAttribute('aria-expanded', String(!isOpen));
            icon.textContent = isOpen ? 'menu' : 'close';
          });
          document.querySelectorAll('.mobile-nav-link').forEach((link) => {
            link.addEventListener('click', () => {
              menu.classList.add('hidden');
              menuBtn.setAttribute('aria-expanded', 'false');
              icon.textContent = 'menu';
            });
          });
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootstrap);
      } else {
        bootstrap();
      }
    </script>
  </body>
</html>
