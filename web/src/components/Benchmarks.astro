---
// Benchmarks.astro - Benchmark comparison table
---

<section id="benchmarks" class="py-16 px-4 max-w-6xl mx-auto">
  <div class="text-center mb-10">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-800 border border-slate-700 text-xs font-mono text-slate-300 mb-2">
      <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-sm text-cyber-cyan shrink-0">monitoring</span>
      INDEPENDENT ARCHITECTURAL BENCHMARK
    </div>
    <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight mb-2">
      Built for Real-Time LLM Pipelines. <br />
      <span class="text-cyber-neon">
        200x Faster than Python &amp; JVM Stacks.
      </span>
    </h2>
    <p class="text-cyber-muted text-sm max-w-2xl mx-auto">
      Measured on AMD Ryzen 9 / Linux x86_64 single thread across 100,000 synthetic JSON payloads.
    </p>
  </div>

  <div class="bg-cyber-card border border-cyber-border rounded-2xl overflow-hidden shadow-2xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm font-mono">
        <thead class="bg-cyber-dark/90 text-cyber-muted uppercase text-xs border-b border-cyber-border">
          <tr>
            <th class="sticky left-0 z-10 bg-cyber-dark py-4 px-6 border-r border-cyber-border/50">DLP Engine / Solution</th>
            <th class="py-4 px-6 text-cyber-neon">Latency (p99)</th>
            <th class="py-4 px-6">RAM Footprint</th>
            <th class="py-4 px-6">LLM SSE Streaming</th>
            <th class="py-4 px-6">Network Egress</th>
            <th class="py-4 px-6">Cost Model</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-cyber-border/60">
          <!-- pii-veil -->
          <tr class="bg-cyber-neon/5 hover:bg-cyber-neon/10 transition">
            <td class="sticky left-0 z-10 bg-[#0d1d24] py-4 px-6 font-bold text-white border-r border-cyber-border/50">
              <span class="inline-flex items-center gap-2 whitespace-nowrap">
                <span class="w-2.5 h-2.5 rounded-full bg-cyber-neon shrink-0"></span>
                <span translate="no" class="notranslate">pii-veil (Rust / WASM)</span>
              </span>
            </td>
            <td class="py-4 px-6 font-bold text-cyber-neon text-base">~100 µs (0.1 ms)</td>
            <td class="py-4 px-6 text-slate-200">&lt; 15 MB</td>
            <td class="py-4 px-6 text-cyber-neon">
              <span class="inline-flex items-center gap-1.5"><span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base shrink-0">check_circle</span> Native Token-by-Token</span>
            </td>
            <td class="py-4 px-6 text-cyber-neon">0 (100% In-Process / Local)</td>
            <td class="py-4 px-6 text-slate-200 font-bold">Open Source / Enterprise SLA</td>
          </tr>

          <!-- Microsoft Presidio -->
          <tr class="hover:bg-slate-800/40 transition">
            <td class="sticky left-0 z-10 bg-cyber-card py-4 px-6 font-medium text-slate-300 border-r border-cyber-border/50 whitespace-nowrap">Microsoft Presidio (Python)</td>
            <td class="py-4 px-6 text-amber-400">~35,000 µs (35 ms)</td>
            <td class="py-4 px-6 text-slate-400">~1,200 MB (spaCy / PyTorch)</td>
            <td class="py-4 px-6 text-red-400">
              <span class="inline-flex items-center gap-1.5"><span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base shrink-0">cancel</span> High buffer latency</span>
            </td>
            <td class="py-4 px-6 text-slate-400">Local Python server</td>
            <td class="py-4 px-6 text-slate-400">High Cloud Server Costs</td>
          </tr>

          <!-- AWS Comprehend -->
          <tr class="hover:bg-slate-800/40 transition">
            <td class="sticky left-0 z-10 bg-cyber-card py-4 px-6 font-medium text-slate-300 border-r border-cyber-border/50 whitespace-nowrap">AWS Comprehend DLP</td>
            <td class="py-4 px-6 text-red-400">~120,000 µs (120 ms)</td>
            <td class="py-4 px-6 text-slate-400">N/A (Managed API)</td>
            <td class="py-4 px-6 text-red-400">
              <span class="inline-flex items-center gap-1.5"><span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base shrink-0">cancel</span> No streaming support</span>
            </td>
            <td class="py-4 px-6 text-red-400">External Cloud Egress</td>
            <td class="py-4 px-6 text-slate-400">$0.0001 per unit (Metered)</td>
          </tr>

          <!-- Google Cloud DLP -->
          <tr class="hover:bg-slate-800/40 transition">
            <td class="sticky left-0 z-10 bg-cyber-card py-4 px-6 font-medium text-slate-300 border-r border-cyber-border/50 whitespace-nowrap">Google Cloud Sensitive Data Protection</td>
            <td class="py-4 px-6 text-red-400">~150,000 µs (150 ms)</td>
            <td class="py-4 px-6 text-slate-400">N/A (Managed API)</td>
            <td class="py-4 px-6 text-red-400">
              <span class="inline-flex items-center gap-1.5"><span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base shrink-0">cancel</span> No streaming support</span>
            </td>
            <td class="py-4 px-6 text-red-400">External Cloud Egress</td>
            <td class="py-4 px-6 text-slate-400">$3.00 per GB inspected</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Reproducibility & Open Harness Callout -->
  <div class="mt-8 bg-gradient-to-r from-slate-900/90 via-cyber-dark to-slate-900/90 border border-cyber-border/80 rounded-2xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
    <div class="text-left space-y-2 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-cyber-neon/10 border border-cyber-neon/30 text-cyber-neon text-xs font-mono font-semibold">
        <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-sm shrink-0">deployed_code</span> 100% AUDITABLE &amp; REPRODUCIBLE
      </div>
      <h3 class="text-xl font-bold text-white tracking-tight">
        Don't trust our numbers. Reproduce them on your own hardware.
      </h3>
      <p class="text-cyber-muted text-sm leading-relaxed">
        We publish and maintain <a href="https://github.com/glastor-core/benchmarks" target="_blank" rel="noopener noreferrer" class="text-cyber-cyan hover:underline font-mono">glastor-core/benchmarks</a>: an open-source apples-to-apples HTTP & systems benchmark suite comparing Rust (Axum), Go (Gin), Node.js (Fastify), and Python (FastAPI) under identical Docker container quotas with <code class="text-cyber-neon text-xs font-mono">k6</code> and <code class="text-cyber-neon text-xs font-mono">wrk</code>.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full md:w-auto">
      <a
        href="https://github.com/glastor-core/benchmarks/tree/main/pii-dlp"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-cyber-neon hover:bg-cyber-neonHover text-cyber-dark font-mono font-bold text-sm tracking-wide transition shadow-[0_0_20px_rgba(0,255,157,0.3)] w-full sm:w-auto text-center"
      >
        <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base shrink-0">bolt</span> Reproduce in Docker (pii-veil vs Presidio)
      </a>
    </div>
  </div>
</section>
