---
// Hero.astro - Top Hero Section
---

<header class="relative pt-14 pb-16 px-4 max-w-7xl mx-auto text-center overflow-hidden">
  <!-- Glowing background effect -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[620px] h-[300px] bg-cyber-neon/10 blur-[140px] pointer-events-none rounded-full"></div>

  <!-- Focused Trust Signals Bar (3 crisp signals) -->
  <div class="flex flex-wrap items-center justify-center gap-2.5 mb-8">
    <span class="px-3 py-1 rounded-full bg-slate-900/90 border border-slate-700/80 text-xs text-cyber-neon font-mono font-semibold inline-flex items-center gap-1.5">
      <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base shrink-0">lock</span>
      Zero Cloud Egress
    </span>
    <span class="px-3 py-1 rounded-full bg-slate-900/90 border border-slate-700/80 text-xs text-slate-200 font-mono inline-flex items-center gap-1.5">
      <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base text-cyber-cyan shrink-0">bolt</span>
      ~100 µs Rust / WASM
    </span>
    <a href="https://github.com/glastor-core/pii-veil/actions/workflows/audit.yml" target="_blank" rel="noopener noreferrer" class="px-3 py-1 rounded-full bg-slate-900/90 border border-slate-700/80 hover:border-cyber-purple text-xs text-purple-300 font-mono transition inline-flex items-center gap-1.5">
      <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-base text-cyber-purple shrink-0">verified_user</span>
      Specter &amp; Byte-Gauge Audited
    </a>
  </div>

  <!-- Main Headline -->
  <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-[1.08] mb-6 max-w-5xl mx-auto">
    Stop PII & Secrets from leaking into LLMs. <br class="hidden sm:inline" />
    <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyber-neon via-cyber-cyan to-cyber-purple">
      In Sub-Milliseconds.
    </span>
  </h1>

  <!-- Subtitle -->
  <p class="text-lg sm:text-xl text-cyber-muted max-w-3xl mx-auto leading-relaxed mb-10">
    Deterministic, reversible anonymization and AEAD vault engine for <strong class="text-slate-100">LLM prompts, MCP agents, and streaming APIs</strong>.
    Zero Python/JVM bloat. No GPU overhead. 200x faster than Microsoft Presidio.
  </p>

  <!-- CTA Buttons -->
  <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
    <a href="#demo" class="px-8 py-3.5 rounded-xl bg-cyber-neon hover:bg-cyber-neonHover text-cyber-dark font-extrabold text-sm sm:text-base tracking-wide transition shadow-[0_0_25px_rgba(0,255,157,0.35)] inline-flex items-center gap-2">
      <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-lg shrink-0">play_arrow</span>
      Try Live Demo Below
    </a>
    <a href="#enterprise" class="px-8 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm sm:text-base border border-slate-700 hover:border-slate-500 transition inline-flex items-center gap-2">
      <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-lg text-cyber-purple shrink-0">domain</span>
      Enterprise On-Premise
    </a>
  </div>

  <!-- Quick Install Cards with 1-click copy -->
  <div class="max-w-4xl mx-auto bg-cyber-card/90 border border-cyber-border rounded-2xl p-4 shadow-xl backdrop-blur-md">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-cyber-border pb-2.5 mb-3 text-xs font-mono">
      <span class="text-cyber-muted inline-flex items-center gap-1.5">
        <span translate="no" aria-hidden="true" class="material-symbols-outlined notranslate text-sm text-cyber-neon shrink-0">terminal</span>
        QUICK INSTALL — <span translate="no" class="notranslate">v1.0.0 GA</span>
      </span>
      <a href="https://crates.io/crates/pii-veil-core" target="_blank" rel="noopener noreferrer" class="inline-flex items-center hover:opacity-90 transition">
        <img src="https://img.shields.io/crates/d/pii-veil-core?logo=rust&color=dea584&label=crates.io%20downloads" alt="crates.io downloads" class="h-[22px] rounded" />
      </a>
    </div>
    <div translate="no" class="notranslate grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 text-xs font-mono">
      <button type="button" data-copy="cargo add pii-veil-core" class="quick-copy-btn group bg-black/50 hover:bg-black/75 p-2.5 rounded-xl border border-cyber-border/50 hover:border-cyber-neon/60 text-left transition flex flex-col justify-between">
        <div class="flex items-center justify-between w-full mb-1">
          <span class="text-cyber-muted text-[10px]">CARGO (RUST)</span>
          <span aria-hidden="true" class="copy-icon material-symbols-outlined notranslate text-sm text-slate-500 group-hover:text-cyber-neon transition">content_copy</span>
        </div>
        <code class="text-cyber-neon text-[11px] truncate w-full">cargo add pii-veil-core</code>
      </button>

      <button type="button" data-copy="pip install glastor-pii-veil" class="quick-copy-btn group bg-black/50 hover:bg-black/75 p-2.5 rounded-xl border border-cyber-border/50 hover:border-cyber-cyan/60 text-left transition flex flex-col justify-between">
        <div class="flex items-center justify-between w-full mb-1">
          <span class="text-cyber-muted text-[10px]">PIP (PYTHON)</span>
          <span aria-hidden="true" class="copy-icon material-symbols-outlined notranslate text-sm text-slate-500 group-hover:text-cyber-cyan transition">content_copy</span>
        </div>
        <code class="text-cyber-cyan text-[11px] truncate w-full">pip install glastor-pii-veil</code>
      </button>

      <button type="button" data-copy="npm i pii-veil-node" class="quick-copy-btn group bg-black/50 hover:bg-black/75 p-2.5 rounded-xl border border-cyber-border/50 hover:border-cyber-purple/60 text-left transition flex flex-col justify-between">
        <div class="flex items-center justify-between w-full mb-1">
          <span class="text-cyber-muted text-[10px]">NPM (NODE.JS)</span>
          <span aria-hidden="true" class="copy-icon material-symbols-outlined notranslate text-sm text-slate-500 group-hover:text-cyber-purple transition">content_copy</span>
        </div>
        <code class="text-purple-300 text-[11px] truncate w-full">npm i pii-veil-node</code>
      </button>

      <button type="button" data-copy="brew install glastor-core/tap/veil" class="quick-copy-btn group bg-black/50 hover:bg-black/75 p-2.5 rounded-xl border border-cyber-border/50 hover:border-amber-400/60 text-left transition flex flex-col justify-between">
        <div class="flex items-center justify-between w-full mb-1">
          <span class="text-cyber-muted text-[10px]">HOMEBREW (CLI)</span>
          <span aria-hidden="true" class="copy-icon material-symbols-outlined notranslate text-sm text-slate-500 group-hover:text-amber-400 transition">content_copy</span>
        </div>
        <code class="text-amber-400 text-[11px] truncate w-full">brew install glastor-core/tap/veil</code>
      </button>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll('.quick-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cmd = btn.getAttribute('data-copy');
      const icon = btn.querySelector('.copy-icon');
      if (!cmd || !icon) return;
      try {
        await navigator.clipboard.writeText(cmd);
        icon.textContent = 'check';
        icon.classList.add('text-cyber-neon');
        setTimeout(() => {
          icon.textContent = 'content_copy';
          icon.classList.remove('text-cyber-neon');
        }, 1600);
      } catch (_) {}
    });
  });
</script>
